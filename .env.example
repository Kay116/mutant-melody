# Copy this file to `.env` and fill in your own value.
# `.env` is git-ignored and must never be committed.
#
# The Groq API key is used ONLY by the server-side function in `api/chat.js`.
# It is never shipped to the browser. See README.md ("AI backend") for setup.

GROQ_API_KEY=your_key_here

# Optional: comma-separated list of origins allowed to call the API.
# Leave unset to allow same-origin requests only.
# ALLOWED_ORIGINS=https://kay116.github.io,http://localhost:8080
